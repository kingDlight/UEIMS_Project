              "  });",
              "  console.log('DRAFT semesters count:', jsonData.length);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/semesters?status=DRAFT",
          "host": ["{{baseUrl}}"],
          "path": ["api", "semesters"],
          "query": [
            { "key": "status", "value": "DRAFT" }
          ]
        }
      }
    },
    {
      "name": "TC-SEM-012: State Machine - GET semester by ID",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200 OK', function() {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('Has required semester fields', function() {",
              "  var jsonData = pm.response.json();",
              "  pm.expect(jsonData).to.have.property('semesterId');",
              "  pm.expect(jsonData).to.have.property('status');",
              "  pm.expect(jsonData).to.have.property('semesterCode');",
              "  pm.expect(jsonData).to.have.property('startDate');",
              "  pm.expect(jsonData).to.have.property('endDate');",
              "  console.log('Semester status:', jsonData.status);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/semesters/{{semesterId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "semesters", "{{semesterId}}"]
        }
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" },
    { "key": "semesterId", "value": "" }
  ]
}
